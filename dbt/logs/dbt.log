        ON dt.trip_id = ls.trip_id

    LEFT JOIN "transit_analytics"."public"."stops" s
        ON st.stop_id = s.stop_id

    GROUP BY
        dt.service_date,
        dt.train_category,
        dt.trip_id
)

SELECT
    service_date,
    train_category,
    COUNT(*) AS scheduled_trips,
    SUM(scheduled_departures) AS scheduled_departures

